[Unit]
Description=Control termico del gabinete ASL (DS18B20 -> ventilador -> Home Assistant)
Documentation=file:/opt/gabinete-fan/docs/hardware.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Se ejecuta como root porque exportar un canal PWM por sysfs lo exige.
# Si prefieres un usuario dedicado, mira docs/hardware.md (reglas udev).
User=root
Environment=PYTHONUNBUFFERED=1
Environment=GABINETE_CONFIG=/etc/gabinete-fan/config.yaml
ExecStart=/usr/bin/python3 -m gabinete_fan
WorkingDirectory=/opt/gabinete-fan
Environment=PYTHONPATH=/opt/gabinete-fan/src

Restart=always
RestartSec=5
# Margen para que el servicio avise a HA, apague el PWM y suelte el watchdog.
# Si se excede, SIGKILL: el latido cesa igual y el respaldo toma el ventilador.
TimeoutStopSec=15
KillSignal=SIGTERM

# Endurecimiento. No se usa ProtectSystem=strict porque hace falta escribir en
# /sys/class/pwm y en /var/lib/gabinete-fan.
NoNewPrivileges=yes
# ProtectHome=yes monta /home VACIO y de solo lectura para el servicio, asi que
# telemetria.csv_dir NO puede apuntar a un directorio del home. El sintoma es
# desconcertante: el servicio arranca bien, anuncia en el journal que inicio el
# registro, y no escribe una sola fila. El unico rastro es:
#   no se pudo escribir el CSV ([Errno 30] Read-only file system: '/home/...')
#
# ReadWritePaths NO es la salida, aunque la documentacion sugiera que se puede
# combinar: probado aqui, systemd acepta la directiva pero no llega a crear el
# punto de montaje y /home sigue siendo un tmpfs vacio de modo 000.
#
# La salida es dejar el registro FUERA de /home -por ejemplo en
# /var/lib/gabinete-fan/telemetria, que StateDirectory ya hace escribible- y,
# si lo quieres a la mano, poner un enlace simbolico desde tu home. El enlace
# lo resuelve tu shell, fuera del espacio aislado del servicio, asi que
# funciona para ti sin que el servicio tenga que entrar a /home.
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
StateDirectory=gabinete-fan

[Install]
WantedBy=multi-user.target
